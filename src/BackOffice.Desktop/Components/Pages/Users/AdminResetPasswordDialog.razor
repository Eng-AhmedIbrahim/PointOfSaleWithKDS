@using BlazorBase.ERPFrontServices.AccountServices
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<style>
    .reset-dialog {
        border-radius: 16px !important;
        overflow: hidden;
    }
    .reset-header {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: white;
        padding: 1.25rem 1.75rem;
        margin: -16px -24px 16px -24px;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.25);
    }
    .reset-header-icon {
        background: rgba(255, 255, 255, 0.2);
        padding: 10px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .user-info-banner {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .field-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem;
        transition: all 0.2s;
        margin-bottom: 1rem;
    }
    .field-card:focus-within {
        border-color: #0284c7;
        background: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .field-label {
        font-weight: 900;
        color: #334155;
        font-size: 0.95rem;
        margin-bottom: 4px;
        display: block;
    }
</style>

<MudDialog Class="reset-dialog" dir="@(IsArabic ? "rtl" : "ltr")">
    <TitleContent>
        <div class="reset-header">
            <div class="reset-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Color="Color.Inherit" />
            </div>
            <div>
                <MudText Typo="Typo.h5" Style="font-weight: 900;">@(IsArabic ? "تغيير كلمة المرور" : "Reset Password")</MudText>
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.85); font-weight: 700;">
                    @(IsArabic ? "تعيين كلمة مرور جديدة للمستخدم" : "Set a new password for user")
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="user-info-banner">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Primary" />
            <div style="display: flex; flex-direction: column;">
                <MudText Style="font-weight: 900; color: #0369a1; font-size: 1.1rem;">
                    @(!string.IsNullOrEmpty(User.ArabicName) ? User.ArabicName : User.UserName)
                </MudText>
                <MudText Typo="Typo.caption" Style="color: #64748b; font-weight: 700;">
                    @(IsArabic ? "اسم المستخدم:" : "Username:") @User.UserName
                </MudText>
            </div>
        </div>

        <div class="field-card">
            <label class="field-label">@(IsArabic ? "كلمة المرور الجديدة" : "New Password")</label>
            <MudTextField @bind-Value="_newPassword"
                          InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                          Variant="MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _showNewPassword = !_showNewPassword"
                          AdornmentAriaLabel="Toggle Password Visibility"
                          Placeholder="@(IsArabic ? "أدخل كلمة المرور الجديدة..." : "Enter new password...")"
                          Style="font-weight: 800; font-size: 1.1rem;" />
        </div>

        <div class="field-card">
            <label class="field-label">@(IsArabic ? "تأكيد كلمة المرور الجديدة" : "Confirm New Password")</label>
            <MudTextField @bind-Value="_confirmPassword"
                          InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                          Variant="MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _showConfirmPassword = !_showConfirmPassword"
                          AdornmentAriaLabel="Toggle Password Visibility"
                          Placeholder="@(IsArabic ? "أعد إدخال كلمة المرور للتأكيد..." : "Re-enter new password...")"
                          Style="font-weight: 800; font-size: 1.1rem;" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="MudBlazor.Variant.Text" Style="font-weight: 900;">
            @(IsArabic ? "تراجع" : "Discard")
        </MudButton>
        <MudButton OnClick="Submit" Variant="MudBlazor.Variant.Filled"
                   Color="Color.Primary" Style="font-weight: 900; padding: 0.6rem 2rem; border-radius: 12px;" 
                   Disabled="@IsSaving">
            @if (IsSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Class="me-2" />
                <MudText>@(IsArabic ? "حفظ كلمة المرور" : "Save Password")</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UserDto User { get; set; } = new();
    [Parameter] public bool IsArabic { get; set; } = true;

    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private bool IsSaving = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add(IsArabic ? "يرجى إدخال كلمة المرور الجديدة" : "Please enter new password", Severity.Warning);
            return;
        }

        if (_newPassword.Length < 3)
        {
            Snackbar.Add(IsArabic ? "يجب ألا تقل كلمة المرور عن 3 أحرف" : "Password must be at least 3 characters", Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(IsArabic ? "كلمة المرور وتأكيدها غير متطابقين" : "Passwords do not match", Severity.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var dto = new AdminResetPasswordDto
            {
                UserId = User.UserId!,
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword
            };

            var (success, errorMessage) = await AccountService.AdminResetPassword(dto);
            if (success)
            {
                Snackbar.Add(IsArabic ? "تم تغيير كلمة المرور بنجاح" : "Password changed successfully", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(errorMessage ?? (IsArabic ? "فشل تغيير كلمة المرور" : "Failed to change password"), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }
}
