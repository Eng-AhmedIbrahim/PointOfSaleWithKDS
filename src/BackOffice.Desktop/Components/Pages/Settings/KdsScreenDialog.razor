@using POS.Contract.Dtos.KitchenDtos
@using POS.Contract.Dtos.CategoryDtos
@using BlazorBase.ERPFrontServices.CategoryServices
@inject ICategoryServices CategoryService
@inject ISnackbar Snackbar
@inject BlazorBase.Services.LocalizationService Localizer

<MudDialog dir="rtl">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Rounded.Tv" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 800;">
                @(Screen.Id > 0 ? "تعديل إعدادات الشاشة" : "إضافة شاشة جديدة (KDS / Pickup)")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="pa-2">
            <!-- Screen Name -->
            <MudTextField @bind-Value="Screen.ScreenName" 
                          Label="اسم الشاشة (مثلاً: مطبخ رئيسي، شاشة جريل، شاشة الاستلام)" 
                          Variant="MudBlazor.Variant.Outlined" 
                          Required="true" 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Rounded.Badge" />

            <!-- Screen Type -->
            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;" Class="mt-1">نوع الشاشة:</MudText>
            <MudRadioGroup @bind-Value="Screen.ScreenType">
                <MudRadio Value="@("Kitchen")" Color="Color.Primary">
                    <span class="font-bold">شاشة مطبخ (KDS)</span>
                    <span class="text-muted d-block small">عرض وتتبع تحضير الوجبات للشيف</span>
                </MudRadio>
                <MudRadio Value="@("Pickup")" Color="Color.Secondary">
                    <span class="font-bold">شاشة تسليم / بيكاب (Pickup Display)</span>
                    <span class="text-muted d-block small">عرض حالات الطلبات (قيد التحضير / جاهز للاستلام)</span>
                </MudRadio>
            </MudRadioGroup>

            <!-- Order Number Filter (All / Odd / Even) -->
            @if (Screen.ScreenType == "Kitchen")
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">توزيع الأوردرات (زوجي / فردي):</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    يمكنك تقسيم أوردرات المطبخ بالتساوي إذا كان لديك شاشتان
                </MudText>
                <MudRadioGroup @bind-Value="Screen.NumberFilter">
                    <MudRadio Value="@("All")" Color="Color.Primary">
                        <b>الكل (All)</b> — استقبال جميع الأوردرات
                    </MudRadio>
                    <MudRadio Value="@("Odd")" Color="Color.Info">
                        <b>فردي فقط (Odd Only)</b> — الأوردرات 1، 3، 5، 7...
                    </MudRadio>
                    <MudRadio Value="@("Even")" Color="Color.Success">
                        <b>زوجي فقط (Even Only)</b> — الأوردرات 2، 4، 6، 8...
                    </MudRadio>
                </MudRadioGroup>

                <!-- Category Filtering -->
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">فلترة الأقسام والأصناف:</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            حدد الأقسام التي تظهر أصنافها على هذه الشاشة (مثل مسارات الطابعات تماماً)
                        </MudText>
                    </div>
                    <MudButton Size="Size.Small" Variant="MudBlazor.Variant.Text" Color="Color.Primary" OnClick="SelectAllCategories">
                        تحديد الكل
                    </MudButton>
                </div>

                @if (_isLoadingCategories)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                }
                else
                {
                    <div style="max-height: 180px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px;">
                        <MudGrid Spacing="1">
                            @foreach (var cat in _availableCategories)
                            {
                                bool isChecked = _selectedCatIds.Contains(cat.Id);
                                <MudItem xs="6">
                                    <MudCheckBox T="bool" 
                                                 Value="isChecked" 
                                                 ValueChanged="@((bool val) => ToggleCategory(cat.Id, val))" 
                                                 Dense="true" 
                                                 Color="Color.Primary">
                                        <span style="font-size: 0.85rem;">@(cat.ArabicName ?? cat.EnglishName ?? "قسم")</span>
                                    </MudCheckBox>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                }
            }

            <!-- Active Status -->
            <div class="d-flex align-center justify-space-between mt-2 pt-2 border-top">
                <MudText Typo="Typo.body2" Style="font-weight: 600;">تفعيل الشاشة للعمل:</MudText>
                <MudSwitch @bind-Value="Screen.IsActive" Color="Color.Success" />
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="MudBlazor.Variant.Text">إلغاء</MudButton>
        <MudButton Color="Color.Primary" Variant="MudBlazor.Variant.Filled" OnClick="Save" StartIcon="@Icons.Material.Rounded.Save">
            حفظ
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public KdsScreenDto Screen { get; set; } = new();

    private List<CategoryToReturnDto> _availableCategories = new();
    private HashSet<int> _selectedCatIds = new();
    private bool _isLoadingCategories = true;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Screen.ScreenType)) Screen.ScreenType = "Kitchen";
        if (string.IsNullOrEmpty(Screen.NumberFilter)) Screen.NumberFilter = "All";

        // Parse existing selected categories
        if (!string.IsNullOrWhiteSpace(Screen.SelectedCategoryIds))
        {
            foreach (var part in Screen.SelectedCategoryIds.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                if (int.TryParse(part.Trim(), out int id))
                    _selectedCatIds.Add(id);
            }
        }

        try
        {
            var res = await CategoryService.GetAllCategories();
            _availableCategories = res?.Data?.ToList() ?? new();
        }
        catch
        {
            _availableCategories = new();
        }
        finally
        {
            _isLoadingCategories = false;
        }
    }

    private void ToggleCategory(int catId, bool isChecked)
    {
        if (isChecked) _selectedCatIds.Add(catId);
        else _selectedCatIds.Remove(catId);
    }

    private void SelectAllCategories()
    {
        if (_selectedCatIds.Count == _availableCategories.Count)
        {
            _selectedCatIds.Clear();
        }
        else
        {
            _selectedCatIds = _availableCategories.Select(c => c.Id).ToHashSet();
        }
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(Screen.ScreenName))
        {
            Snackbar.Add("يرجى إدخال اسم الشاشة", Severity.Warning);
            return;
        }

        if (Screen.ScreenType == "Kitchen")
        {
            Screen.SelectedCategoryIds = _selectedCatIds.Any() ? string.Join(",", _selectedCatIds) : null;
        }
        else
        {
            Screen.SelectedCategoryIds = null;
            Screen.NumberFilter = "All";
        }

        MudDialog.Close(DialogResult.Ok(Screen));
    }

    private void Cancel() => MudDialog.Cancel();
}
