@page "/"
@using BackOffice.Desktop.Models
@attribute [Authorize]
@inject IReportingErpService ReportingService
@inject IAppDateService AppDateService
@inject ISnackbar Snackbar
@inject BlazorBase.Services.LocalizationService LocalizerService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="dashboard-wrapper @(IsArabic ? "rtl-mode" : "") @( !_canViewDashboard ? "dashboard-disabled" : "")" dir="@(IsArabic ? "rtl" : "ltr")">
    @if (!_canViewDashboard)
    {
        <div class="permission-overlay">
            <div class="overlay-content">
                <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Large" Class="mb-4 text-muted" />
                <h2 class="text-muted">@LocalizerService["AccessRestricted"]</h2>
                <p class="text-muted">لا تملك صلاحية عرض لوحة البيانات الإحصائية</p>
                <p class="text-muted small">You don't have permission to view dashboard analytics.</p>
            </div>
        </div>
    }

    <!-- ════════════════════ TOP HEADER BAR (Odoo / NerithonX Style) ════════════════════ -->
    <div class="dashboard-top-header">
        <div class="header-left-title">
            <div class="d-flex align-center gap-2">
                <h1 class="main-dashboard-title">لوحة التحكم المالية والمبيعات</h1>
                <span class="live-pill"><span class="live-dot"></span> مباشر</span>
            </div>
            <div class="d-flex align-center gap-2 mt-1">
                <p class="sub-dashboard-title">نظرة عامة متكاملة على المبيعات، التحصيلات، الخصومات، والفويدات</p>
                @if (_selectedFilter != "Today" || SelectedDate.HasValue)
                {
                    <span class="date-range-badge">
                        <MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Size="Size.Small" Class="me-1" />
                        @_dateRangeLabel
                    </span>
                }
            </div>
        </div>

        <div class="header-right-actions">
            <!-- Quick Date Filters -->
            <div class="quick-filter-pills">
                <button class="filter-pill @(_selectedFilter == "Today" ? "active" : "")" @onclick='() => SetQuickFilter("Today")'>اليوم</button>
                <button class="filter-pill @(_selectedFilter == "Yesterday" ? "active" : "")" @onclick='() => SetQuickFilter("Yesterday")'>أمس</button>
                <button class="filter-pill @(_selectedFilter == "ThisMonth" ? "active" : "")" @onclick='() => SetQuickFilter("ThisMonth")'>
                    <MudIcon Icon="@Icons.Material.Rounded.CalendarViewMonth" Size="Size.Small" Class="me-1" />
                    هذا الشهر
                </button>
                <button class="filter-pill filter-pill-range @(_selectedFilter == "Range" ? "active" : "")" @onclick="ToggleDateRange">
                    <MudIcon Icon="@Icons.Material.Rounded.DateRange" Size="Size.Small" Class="me-1" />
                    مدة مخصصة
                </button>
            </div>

            <!-- Date Range Picker (shown only when Range mode) -->
            @if (_selectedFilter == "Range")
            {
                <div class="date-range-box">
                    <div class="date-range-item">
                        <span class="date-range-lbl">من</span>
                        <MudDatePicker Date="@_rangeStart"
                                       DateChanged="OnRangeStartChanged"
                                       DateFormat="yyyy-MM-dd"
                                       Class="compact-date-picker"
                                       DisableToolbar="true"
                                       MaxDate="@(_rangeEnd ?? DateTime.Today)" />
                    </div>
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="range-arrow" />
                    <div class="date-range-item">
                        <span class="date-range-lbl">إلى</span>
                        <MudDatePicker Date="@_rangeEnd"
                                       DateChanged="OnRangeEndChanged"
                                       DateFormat="yyyy-MM-dd"
                                       Class="compact-date-picker"
                                       DisableToolbar="true"
                                       MinDate="@_rangeStart" />
                    </div>
                </div>
            }
            else
            {
                <!-- Single Date Picker for Today/Yesterday/ThisMonth -->
                <div class="date-picker-box">
                    <MudIcon Icon="@Icons.Material.Rounded.CalendarToday" Size="Size.Small" Class="date-icon" />
                    <MudDatePicker Date="@SelectedDate"
                                   DateChanged="OnDateChanged"
                                   DateFormat="yyyy-MM-dd"
                                   Class="compact-date-picker"
                                   DisableToolbar="true" />
                </div>
            }

            <!-- Refresh Button -->
            <button class="btn-refresh @(_isRefreshing ? "spinning" : "")" @onclick="RefreshDashboard" title="تحديث البيانات">
                <MudIcon Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" />
                <span>تحديث</span>
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="loading-overlay">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <p class="mt-4 text-muted font-bold">جاري تحميل المؤشرات والرسوم البيانية... Loading Dashboard</p>
        </div>
    }
    else if (_canViewDashboard && SummaryInfo != null)
    {
        <!-- ════════════════════ 6 DEDICATED KPI CARDS (SEPARATE DISCOUNTS & VOIDS) ════════════════════ -->
        <div class="kpi-grid-container">
            <!-- 1. Total Revenue -->
            <div class="kpi-card border-blue">
                <div class="kpi-card-top">
                    <div class="kpi-icon-badge bg-blue-subtle text-blue">
                        <MudIcon Icon="@Icons.Material.Rounded.AttachMoney" />
                    </div>
                    <span class="kpi-trend-badge badge-green">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /> مبيعات
                    </span>
                </div>
                <div class="kpi-body">
                    <div class="kpi-title">إجمالي المبيعات (Revenue)</div>
                    <div class="kpi-value-row">
                        <span class="kpi-currency">EGP</span>
                        <span class="kpi-value text-blue">@SummaryInfo.Overall.TotalSales.ToString("N0")</span>
                    </div>
                </div>
                <div class="kpi-sparkline">
                    <svg viewBox="0 0 120 28" class="sparkline-svg">
                        <path d="@GetSparklinePath(1, 120, 24)" fill="none" stroke="#2563eb" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- 2. Cash Collected -->
            <div class="kpi-card border-emerald">
                <div class="kpi-card-top">
                    <div class="kpi-icon-badge bg-emerald-subtle text-emerald">
                        <MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" />
                    </div>
                    <span class="kpi-trend-badge badge-green">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> نقدية
                    </span>
                </div>
                <div class="kpi-body">
                    <div class="kpi-title">التحصيل النقدي (Cash)</div>
                    <div class="kpi-value-row">
                        <span class="kpi-currency">EGP</span>
                        <span class="kpi-value text-emerald">@SummaryInfo.Overall.CashAmount.ToString("N0")</span>
                    </div>
                </div>
                <div class="kpi-sparkline">
                    <svg viewBox="0 0 120 28" class="sparkline-svg">
                        <path d="@GetSparklinePath(2, 120, 24)" fill="none" stroke="#10b981" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- 3. Electronic / Visa -->
            <div class="kpi-card border-cyan">
                <div class="kpi-card-top">
                    <div class="kpi-icon-badge bg-cyan-subtle text-cyan">
                        <MudIcon Icon="@Icons.Material.Rounded.CreditCard" />
                    </div>
                    <span class="kpi-trend-badge badge-cyan">
                        <MudIcon Icon="@Icons.Material.Filled.CreditScore" Size="Size.Small" /> شبكة
                    </span>
                </div>
                <div class="kpi-body">
                    <div class="kpi-title">الفيزا والشبكة (Card)</div>
                    <div class="kpi-value-row">
                        <span class="kpi-currency">EGP</span>
                        <span class="kpi-value text-cyan">@SummaryInfo.Overall.CreditAmount.ToString("N0")</span>
                    </div>
                </div>
                <div class="kpi-sparkline">
                    <svg viewBox="0 0 120 28" class="sparkline-svg">
                        <path d="@GetSparklinePath(3, 120, 24)" fill="none" stroke="#06b6d4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- 4. Total Orders Count -->
            <div class="kpi-card border-purple">
                <div class="kpi-card-top">
                    <div class="kpi-icon-badge bg-purple-subtle text-purple">
                        <MudIcon Icon="@Icons.Material.Rounded.ShoppingBag" />
                    </div>
                    <span class="kpi-trend-badge badge-purple">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" /> فواتير
                    </span>
                </div>
                <div class="kpi-body">
                    <div class="kpi-title">عدد الطلبات (Orders)</div>
                    <div class="kpi-value-row">
                        <span class="kpi-value text-purple">@TotalOrdersCount.ToString("N0")</span>
                        <span class="kpi-subtext">طلب</span>
                    </div>
                </div>
                <div class="kpi-sparkline">
                    <svg viewBox="0 0 120 28" class="sparkline-svg">
                        <path d="@GetSparklinePath(4, 120, 24)" fill="none" stroke="#8b5cf6" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- 5. DISCOUNTS ONLY (مفصولة تماماً بلون برتقالي واضح) -->
            <div class="kpi-card border-amber">
                <div class="kpi-card-top">
                    <div class="kpi-icon-badge bg-amber-subtle text-amber">
                        <MudIcon Icon="@Icons.Material.Rounded.Discount" />
                    </div>
                    <span class="kpi-trend-badge badge-amber">
                        <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" /> تخفيضات
                    </span>
                </div>
                <div class="kpi-body">
                    <div class="kpi-title">إجمالي الخصومات (Discounts)</div>
                    <div class="kpi-value-row">
                        <span class="kpi-currency">EGP</span>
                        <span class="kpi-value text-amber">@SummaryInfo.Overall.TotalDiscount.ToString("N0")</span>
                    </div>
                </div>
                <div class="kpi-sparkline">
                    <svg viewBox="0 0 120 28" class="sparkline-svg">
                        <path d="@GetSparklinePath(5, 120, 24)" fill="none" stroke="#f59e0b" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- 6. VOIDS ONLY (مفصولة تماماً بلون أحمر قرمزي بارز) -->
            <div class="kpi-card border-rose">
                <div class="kpi-card-top">
                    <div class="kpi-icon-badge bg-rose-subtle text-rose">
                        <MudIcon Icon="@Icons.Material.Rounded.CancelPresentation" />
                    </div>
                    <span class="kpi-trend-badge badge-rose">
                        <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" /> @SummaryInfo.Overall.VoidCount ملغي
                    </span>
                </div>
                <div class="kpi-body">
                    <div class="kpi-title">الفويدات والملغي (Voids)</div>
                    <div class="kpi-value-row">
                        <span class="kpi-currency">EGP</span>
                        <span class="kpi-value text-rose">@SummaryInfo.Overall.VoidAmount.ToString("N0")</span>
                    </div>
                </div>
                <div class="kpi-sparkline">
                    <svg viewBox="0 0 120 28" class="sparkline-svg">
                        <path d="@GetSparklinePath(6, 120, 24)" fill="none" stroke="#f43f5e" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- ════════════════════ CHARTS SECTION ROW 1: SALES TREND & CHANNEL BREAKDOWN ════════════════════ -->
        <div class="analytics-grid-row mt-4">
            <!-- 1. Sales Trend (CLEAN NON-OVERLAPPING BAR/COLUMN CHART) -->
            <div class="chart-panel flex-trend">
                <div class="panel-header">
                    <div>
                        <h3 class="panel-title">اتجاه المبيعات وساعات العمل (Sales Trend)</h3>
                        <p class="panel-subtitle">توزيع المبيعات على فترات التشغيل بدون أي تداخل</p>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <span class="chip-metric chip-blue">● المبيعات (EGP)</span>
                    </div>
                </div>
                <div class="chart-box" style="height: 250px;">
                    <RadzenChart Style="height: 250px; width: 100%;">
                        <RadzenColumnSeries Data="@_trendDataPoints"
                                            CategoryProperty="Time"
                                            Title="المبيعات"
                                            ValueProperty="Value"
                                            Fill="#3b82f6">
                            <TooltipTemplate Context="pt">
                                <div class="rz-tooltip-content">
                                    <div class="tooltip-time">الفترة: @pt.Time</div>
                                    <div class="tooltip-val">@pt.Value.ToString("N0") EGP</div>
                                </div>
                            </TooltipTemplate>
                        </RadzenColumnSeries>
                        <RadzenCategoryAxis Padding="15">
                            <RadzenGridLines Visible="false" />
                        </RadzenCategoryAxis>
                        <RadzenValueAxis Min="0">
                            <RadzenGridLines Visible="true" Stroke="rgba(0,0,0,0.06)" />
                            <RadzenAxisTitle Text="EGP" />
                        </RadzenValueAxis>
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                </div>
            </div>

            <!-- 2. Sales by Channel (Donut Chart) -->
            <div class="chart-panel flex-donut">
                <div class="panel-header">
                    <div>
                        <h3 class="panel-title">قنوات المبيعات (Channels)</h3>
                        <p class="panel-subtitle">توزيع الإيرادات بين الصالة والتيك أواي والتوصيل</p>
                    </div>
                </div>

                <div class="donut-and-legend-box">
                    <div class="donut-center-container">
                        <MudChart ChartType="ChartType.Donut" 
                                  InputData="@ChannelData" 
                                  InputLabels="@ChannelLabels"
                                  Width="175px" 
                                  Height="175px"
                                  ChartOptions="@ChannelDonutOptions" />
                        <div class="donut-center-label">
                            <span class="donut-small-title">الطلبات</span>
                            <span class="donut-big-val">@TotalOrdersCount</span>
                            <span class="donut-currency">طلب</span>
                        </div>
                    </div>

                    <div class="donut-legend-list">
                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot" style="background:#3b82f6;"></span>
                                <span class="legend-name">تيك أواي (TakeAway)</span>
                            </div>
                            <div class="legend-vals">
                                <span class="legend-amount">@SummaryInfo.TakeAway.Total.ToString("N0") EGP</span>
                                <span class="legend-pct">@(GetPct(SummaryInfo.TakeAway.Total, SummaryInfo.Overall.TotalSales))%</span>
                            </div>
                        </div>

                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot" style="background:#10b981;"></span>
                                <span class="legend-name">دليفري (Delivery)</span>
                            </div>
                            <div class="legend-vals">
                                <span class="legend-amount">@SummaryInfo.Delivery.Total.ToString("N0") EGP</span>
                                <span class="legend-pct">@(GetPct(SummaryInfo.Delivery.Total, SummaryInfo.Overall.TotalSales))%</span>
                            </div>
                        </div>

                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot" style="background:#8b5cf6;"></span>
                                <span class="legend-name">صالة (Dine-In)</span>
                            </div>
                            <div class="legend-vals">
                                <span class="legend-amount">@SummaryInfo.DineIn.Total.ToString("N0") EGP</span>
                                <span class="legend-pct">@(GetPct(SummaryInfo.DineIn.Total, SummaryInfo.Overall.TotalSales))%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════════════ CHARTS SECTION ROW 2: CATEGORIES & RESTRUCTURED PAYMENT INSIGHTS ════════════════════ -->
        <div class="analytics-grid-row mt-4">
            <!-- 3. Category Sales Distribution -->
            <div class="chart-panel flex-equal">
                <div class="panel-header">
                    <div>
                        <h3 class="panel-title">تحليل أقسام الأصناف (Categories)</h3>
                        <p class="panel-subtitle">نسبة مساهمة كل قسم في إجمالي مبيعات اليوم</p>
                    </div>
                    <span class="chip-metric chip-purple">الأقسام الأكثر طلباً</span>
                </div>

                <div class="donut-and-legend-box">
                    <div class="donut-center-container">
                        <MudChart ChartType="ChartType.Donut" 
                                  InputData="@CategoryData" 
                                  InputLabels="@CategoryLabels"
                                  Width="175px" 
                                  Height="175px"
                                  ChartOptions="@CategoryDonutOptions" />
                    </div>

                    <div class="donut-legend-list">
                        @if (TopCategories != null && TopCategories.Any())
                        {
                            @foreach (var (cat, idx) in TopCategories.Select((c, i) => (c, i)))
                            {
                                var catColor = CategoryPalette.ElementAtOrDefault(idx) ?? "#64748b";
                                <div class="legend-row">
                                    <div class="legend-info">
                                        <span class="legend-dot" style="background:@catColor;"></span>
                                        <span class="legend-name">@cat.Name</span>
                                    </div>
                                    <div class="legend-vals">
                                        <span class="legend-amount">@cat.Amount.ToString("N0") EGP</span>
                                        <span class="legend-pct">@(GetPct((decimal)cat.Amount, SummaryInfo.Overall.TotalSales))%</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- 4. Payment Insights (RESTRUCTURED & POLISHED) -->
            <div class="chart-panel flex-equal">
                <div class="panel-header">
                    <div>
                        <h3 class="panel-title">طرق الدفع والتحصيل</h3>
                        <p class="panel-subtitle">تفصيل التحصيلات النقدية والإلكترونية وحسابات الآجل</p>
                    </div>
                    <span class="chip-metric chip-green">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="me-1" />
                        التحصيلات
                    </span>
                </div>

                <div class="payment-insights-grid">
                    <!-- Left: Clean Donut with Exact Total in Center -->
                    <div class="payment-donut-wrap">
                        <div class="donut-center-container">
                            <MudChart ChartType="ChartType.Donut" 
                                      InputData="@PaymentData" 
                                      InputLabels="@PaymentLabels"
                                      Width="170px" 
                                      Height="170px"
                                      ChartOptions="@PaymentDonutOptions" />
                            <div class="donut-center-label">
                                <span class="donut-small-title">إجمالي المحصل</span>
                                <span class="donut-exact-val">@SummaryInfo.Overall.TotalSales.ToString("N0")</span>
                                <span class="donut-currency">ج.م</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Polished Clean Metric Cards with Micro-Progress -->
                    <div class="payment-cards-list">
                        <!-- Cash -->
                        <div class="pay-stat-card border-accent-emerald">
                            <div class="pay-stat-top">
                                <div class="pay-stat-name">
                                    <div class="pay-icon-badge bg-emerald-subtle text-emerald">
                                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                                    </div>
                                    <div class="pay-title-group">
                                        <span class="pay-main-name">نقدي (كاش)</span>
                                        <span class="pay-pct-pill bg-emerald-light text-emerald">@(GetPct(SummaryInfo.Overall.CashAmount, SummaryInfo.Overall.TotalSales))%</span>
                                    </div>
                                </div>
                                <div class="pay-stat-val text-emerald">
                                    <span class="amount-num">@SummaryInfo.Overall.CashAmount.ToString("N0")</span>
                                    <span class="amount-curr">ج.م</span>
                                </div>
                            </div>
                            <div class="pay-progress-wrap">
                                <div class="pay-progress-bar bg-emerald" style="width: @(GetPct(SummaryInfo.Overall.CashAmount, SummaryInfo.Overall.TotalSales))%;"></div>
                            </div>
                        </div>

                        <!-- Card / Visa -->
                        <div class="pay-stat-card border-accent-blue">
                            <div class="pay-stat-top">
                                <div class="pay-stat-name">
                                    <div class="pay-icon-badge bg-blue-subtle text-blue">
                                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" />
                                    </div>
                                    <div class="pay-title-group">
                                        <span class="pay-main-name">شبكة / فيزا (إلكتروني)</span>
                                        <span class="pay-pct-pill bg-blue-light text-blue">@(GetPct(SummaryInfo.Overall.CreditAmount, SummaryInfo.Overall.TotalSales))%</span>
                                    </div>
                                </div>
                                <div class="pay-stat-val text-blue">
                                    <span class="amount-num">@SummaryInfo.Overall.CreditAmount.ToString("N0")</span>
                                    <span class="amount-curr">ج.م</span>
                                </div>
                            </div>
                            <div class="pay-progress-wrap">
                                <div class="pay-progress-bar bg-blue" style="width: @(GetPct(SummaryInfo.Overall.CreditAmount, SummaryInfo.Overall.TotalSales))%;"></div>
                            </div>
                        </div>

                        <!-- Credit / On Account -->
                        <div class="pay-stat-card border-accent-amber">
                            <div class="pay-stat-top">
                                <div class="pay-stat-name">
                                    <div class="pay-icon-badge bg-amber-subtle text-amber">
                                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                                    </div>
                                    <div class="pay-title-group">
                                        <span class="pay-main-name">آجل / معلق (حسابات)</span>
                                        <span class="pay-pct-pill bg-amber-light text-amber">@(GetPct(SummaryInfo.Overall.OnAccountAmount, SummaryInfo.Overall.TotalSales))%</span>
                                    </div>
                                </div>
                                <div class="pay-stat-val text-amber">
                                    <span class="amount-num">@SummaryInfo.Overall.OnAccountAmount.ToString("N0")</span>
                                    <span class="amount-curr">ج.م</span>
                                </div>
                            </div>
                            <div class="pay-progress-wrap">
                                <div class="pay-progress-bar bg-amber" style="width: @(GetPct(SummaryInfo.Overall.OnAccountAmount, SummaryInfo.Overall.TotalSales))%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════════════ BOTTOM SECTION: RECENT ORDERS & TOP PRODUCTS ════════════════════ -->
        <div class="bottom-tables-row mt-4">
            <!-- Left: Recent Orders (Fixed Link to: /transactions/all-orders) -->
            <div class="table-card flex-orders">
                <div class="panel-header">
                    <div>
                        <h3 class="panel-title">أحدث الفواتير والطلبات (Recent Orders)</h3>
                        <p class="panel-subtitle">آخر العمليات المكتملة عبر نقاط البيع</p>
                    </div>
                    <MudButton Variant="MudBlazor.Variant.Text" 
                               Color="Color.Primary" 
                               EndIcon="@Icons.Material.Rounded.ArrowForward"
                               OnClick='() => NavigationManager.NavigateTo("/transactions/all-orders")'
                               Class="text-caption font-bold">
                        عرض الكل
                    </MudButton>
                </div>

                <div class="orders-table-wrapper">
                    @if (_todayOrders != null && _todayOrders.Any())
                    {
                        <table class="modern-dashboard-table">
                            <thead>
                                <tr>
                                    <th>رقم الطلب</th>
                                    <th>النوع</th>
                                    <th>الوقت</th>
                                    <th>الحالة</th>
                                    <th>الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in _todayOrders.OrderByDescending(o => o.OrderId).Take(5))
                                {
                                    <tr>
                                        <td class="font-bold text-slate-800">#@order.OrderId</td>
                                        <td>
                                            <span class="order-type-chip @GetOrderTypeClass(order.OrderType)">
                                                @GetOrderTypeAr(order.OrderType)
                                            </span>
                                        </td>
                                        <td class="text-muted text-sm">@(order.OrderDate?.ToString("hh:mm tt") ?? "-")</td>
                                        <td>
                                            <span class="status-badge @(order.OrderState == "Completed" ? "status-success" : order.OrderState == "Voided" ? "status-danger" : "status-warning")">
                                                @(order.OrderState == "Completed" ? "مكتمل" : order.OrderState == "Voided" ? "ملغي" : "معلق")
                                            </span>
                                        </td>
                                        <td class="font-extrabold text-blue text-end">
                                            @((order.GrandTotal ?? 0).ToString("N0")) <small class="text-xs text-muted">EGP</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state-box">
                            <MudIcon Icon="@Icons.Material.Rounded.Inbox" Size="Size.Large" Class="text-muted mb-2" />
                            <p class="text-muted">لا توجد طلبات مسجلة اليوم حتى الآن</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Top Products (NO MORE CUTOFF "قطعة" - CLEAN CLEAR QUANTITY & REVENUE) -->
            <div class="table-card flex-items">
                <div class="panel-header">
                    <div>
                        <h3 class="panel-title">أعلى الأصناف إيراداً (Top Products)</h3>
                        <p class="panel-subtitle">الأصناف الأكثر طلباً ومبيعاً اليوم</p>
                    </div>
                    <span class="chip-metric chip-green">Top 5</span>
                </div>

                <div class="top-items-container">
                    @if (TopItems != null && TopItems.Any())
                    {
                        @foreach (var (item, index) in TopItems.Take(5).Select((v, i) => (v, i)))
                        {
                            var pct = SummaryInfo.Overall.TotalSales > 0 ? (item.TotalAmount / SummaryInfo.Overall.TotalSales * 100m) : 0m;
                            <div class="top-item-row">
                                <div class="item-rank-badge rank-@index">@(index + 1)</div>
                                <div class="item-main-info">
                                    <div class="item-name-header">
                                        <span class="item-title">@item.ItemName</span>
                                        <span class="item-revenue">@item.TotalAmount.ToString("N0") <small>EGP</small></span>
                                    </div>
                                    <div class="item-sub-details">
                                        <span class="item-cat-tag">@item.CategoryName</span>
                                        <span class="item-qty-tag">الكمية: @item.Quantity.ToString("N0")</span>
                                        <span class="item-pct-tag">@pct.ToString("0.#")% من المبيعات</span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill" style="width: @Math.Min(100, Math.Max(8, (double)pct * 2.5))%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state-box">
                            <MudIcon Icon="@Icons.Material.Rounded.RestaurantMenu" Size="Size.Large" Class="text-muted mb-2" />
                            <p class="text-muted">لا توجد أصناف مباعة اليوم</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ════════════════════ SYSTEM STATUS FOOTER ════════════════════ -->
        <div class="dashboard-footer-bar mt-4 mb-2">
            <div class="footer-status-item">
                <span class="status-indicator-dot dot-online"></span>
                <span class="footer-label">الكاشير:</span>
                <span class="footer-value">@(_currentUserName ?? "Administrator")</span>
            </div>

            <div class="footer-status-item">
                <MudIcon Icon="@Icons.Material.Rounded.Storage" Size="Size.Small" Class="footer-icon text-blue" />
                <span class="footer-label">قاعدة البيانات:</span>
                <span class="footer-value text-emerald">متصلة وجاهزة</span>
            </div>

            <div class="footer-status-item">
                <MudIcon Icon="@Icons.Material.Rounded.AccessTime" Size="Size.Small" Class="footer-icon text-muted" />
                <span class="footer-label">آخر تحديث:</span>
                <span class="footer-value">@_lastUpdated.ToString("hh:mm:ss tt")</span>
            </div>

            <div class="footer-status-item">
                <MudIcon Icon="@Icons.Material.Rounded.Verified" Size="Size.Small" Class="footer-icon text-purple" />
                <span class="footer-label">الإصدار:</span>
                <span class="footer-value">POS Enterprise v2.5</span>
            </div>
        </div>
    }
</div>

@code {
    public class SalesDataPoint { public string Time { get; set; } = ""; public double Value { get; set; } }
    public class CatSummaryItem { public string Name { get; set; } = ""; public double Amount { get; set; } }

    private List<SalesDataPoint> _trendDataPoints = new();
    private List<OrderDto> _todayOrders = new();
    public List<CatSummaryItem> TopCategories = new();

    public DateTime? SelectedDate { get; set; }
    public SalesSummaryDto? SummaryInfo { get; set; }
    public List<SalesItemSummaryDto> ItemSummary { get; set; } = new();
    public bool IsLoading { get; set; } = true;
    private bool _canViewDashboard = false;
    private bool _isRefreshing = false;
    private string _selectedFilter = "Today";
    private DateTime _lastUpdated = DateTime.Now;
    private string? _currentUserName;

    // Date Range support
    private DateTime? _rangeStart;
    private DateTime? _rangeEnd;

    // Effective date range for all API calls
    private DateTime _effectiveDateFrom => 
        _selectedFilter == "Range" ? (_rangeStart ?? SelectedDate ?? DateTime.Today) :
        _selectedFilter == "ThisMonth" ? (_rangeStart ?? (SelectedDate.HasValue ? new DateTime(SelectedDate.Value.Year, SelectedDate.Value.Month, 1) : DateTime.Today)) :
        (SelectedDate ?? DateTime.Today);
    private DateTime? _effectiveDateTo =>
        _selectedFilter == "Range" ? _rangeEnd :
        _selectedFilter == "ThisMonth" ? (_rangeEnd ?? SelectedDate) : null;

    // Date range label for header display
    private string _dateRangeLabel =>
        _selectedFilter == "Range" && _rangeStart.HasValue && _rangeEnd.HasValue
            ? $"{_rangeStart:yyyy/MM/dd} ← {_rangeEnd:yyyy/MM/dd}"
        : _selectedFilter == "ThisMonth"
            ? $"شهر {SelectedDate:MMMM yyyy}"
        : _selectedFilter == "Yesterday"
            ? $"أمس {SelectedDate:yyyy/MM/dd}"
        : $"اليوم {SelectedDate:yyyy/MM/dd}";

    // Palette & Options for Channel Donut
    public static readonly string[] ChannelPalette = new[] { "#3b82f6", "#10b981", "#8b5cf6" };
    public ChartOptions ChannelDonutOptions = new() { ChartPalette = ChannelPalette };
    public double[] ChannelData = new double[] { 1, 1, 1 };
    public string[] ChannelLabels = new string[] { "تيك أواي", "دليفري", "صالة" };

    // Palette & Options for Payment Donut
    public static readonly string[] PaymentPalette = new[] { "#10b981", "#0ea5e9", "#f59e0b" };
    public ChartOptions PaymentDonutOptions = new() { ChartPalette = PaymentPalette };
    public double[] PaymentData = new double[] { 1, 1, 1 };
    public string[] PaymentLabels = new string[] { "كاش", "فيزا", "آجل" };

    // Palette & Options for Category Donut
    public static readonly string[] CategoryPalette = new[] { "#6366f1", "#ec4899", "#f59e0b", "#10b981", "#06b6d4", "#8b5cf6" };
    public ChartOptions CategoryDonutOptions = new() { ChartPalette = CategoryPalette };
    public double[] CategoryData = new double[] { 1 };
    public string[] CategoryLabels = new string[] { "عام" };

    public List<SalesItemSummaryDto> TopItems = new();
    private int TotalOrdersCount => (SummaryInfo?.DineIn.OrderCount ?? 0) + (SummaryInfo?.Delivery.OrderCount ?? 0) + (SummaryInfo?.TakeAway.OrderCount ?? 0);
    private decimal AverageOrderValue => TotalOrdersCount > 0 ? (SummaryInfo?.Overall.TotalSales ?? 0) / TotalOrdersCount : 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserName = user.Identity?.Name ?? "Administrator";
        _canViewDashboard = (await AuthorizationService.AuthorizeAsync(user, "CanViewDashboardAtBackOffice")).Succeeded;

        if (_canViewDashboard)
        {
            var appDateObj = await AppDateService.GetAppDate();
            SelectedDate = appDateObj?.PosDate ?? DateTime.Today;
            await LoadData();
        }
        else
        {
            IsLoading = false;
        }
    }

    private async Task SetQuickFilter(string filter)
    {
        _selectedFilter = filter;
        var appDateObj = await AppDateService.GetAppDate();
        var baseDate = appDateObj?.PosDate ?? DateTime.Today;

        if (filter == "Today")
        {
            SelectedDate = baseDate;
        }
        else if (filter == "Yesterday")
        {
            SelectedDate = baseDate.AddDays(-1);
        }
        else if (filter == "ThisMonth")
        {
            // Load from the 1st of this month to today's POS date
            _rangeStart = new DateTime(baseDate.Year, baseDate.Month, 1);
            _rangeEnd = baseDate;
            SelectedDate = baseDate;
        }

        await LoadData();
    }

    private void ToggleDateRange()
    {
        _selectedFilter = "Range";
        if (_rangeStart == null) _rangeStart = SelectedDate;
        if (_rangeEnd == null) _rangeEnd = SelectedDate;
        StateHasChanged();
    }

    private async Task OnRangeStartChanged(DateTime? date)
    {
        _rangeStart = date;
        if (_rangeStart.HasValue && _rangeEnd.HasValue && _rangeStart <= _rangeEnd)
        {
            SelectedDate = _rangeStart;
            await LoadData();
        }
    }

    private async Task OnRangeEndChanged(DateTime? date)
    {
        _rangeEnd = date;
        if (_rangeStart.HasValue && _rangeEnd.HasValue && _rangeStart <= _rangeEnd)
        {
            SelectedDate = _rangeStart;
            await LoadData();
        }
    }

    private async Task OnDateChanged(DateTime? date)
    {
        SelectedDate = date;
        _selectedFilter = "Custom";
        await LoadData();
    }

    private async Task RefreshDashboard()
    {
        _isRefreshing = true;
        StateHasChanged();
        await LoadData();
        _isRefreshing = false;
        Snackbar.Add("تم تحديث بيانات اللوحة بنجاح", Severity.Info);
        StateHasChanged();
    }

    private async Task LoadData()
    {
        if (SelectedDate == null) return;
        IsLoading = true;
        StateHasChanged();

        try
        {
            var dateFrom = _effectiveDateFrom;
            var dateTo = _effectiveDateTo;

            var summaryTask = ReportingService.GetSalesSummary(dateFrom, dateTo);
            var itemSummaryTask = ReportingService.GetSalesItemsSummary(dateFrom, dateTo);
            // Orders (for trend chart): load from dateFrom only
            var ordersTask = ReportingService.GetTodayOrders(dateFrom);

            await Task.WhenAll(summaryTask, itemSummaryTask, ordersTask);

            SummaryInfo = summaryTask.Result;
            ItemSummary = itemSummaryTask.Result;
            _todayOrders = ordersTask.Result;
            _lastUpdated = DateTime.Now;

            BuildAnalytics();
        }
        catch (Exception ex)
        {
            Snackbar.Add("تعذر تحديث المؤشرات المالية.", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
        StateHasChanged();
    }

    private void BuildAnalytics()
    {
        if (SummaryInfo == null) return;

        // Determine if this is a multi-day range (Month or custom range)
        bool isMultiDay = _selectedFilter == "ThisMonth" 
            || (_selectedFilter == "Range" && _rangeStart.HasValue && _rangeEnd.HasValue && _rangeEnd.Value > _rangeStart.Value);

        // 1. Trend Points
        _trendDataPoints = new List<SalesDataPoint>();
        double totalSales = (double)SummaryInfo.Overall.TotalSales;

        if (isMultiDay)
        {
            // For multi-day: build daily distribution from orders grouped by day
            var dateFrom = _effectiveDateFrom;
            var dateTo = _effectiveDateTo ?? dateFrom;
            int totalDays = (int)(dateTo - dateFrom).TotalDays + 1;

            var sourceOrders = (SummaryInfo?.DetailedOrders != null && SummaryInfo.DetailedOrders.Any()) 
                ? SummaryInfo.DetailedOrders 
                : (_todayOrders ?? new());

            var dailyData = sourceOrders
                .Where(o => o.OrderDate.HasValue && o.OrderState == "Completed" && (o.GrandTotal ?? 0) > 0)
                .GroupBy(o => o.OrderDate!.Value.Date)
                .Select(g => new { Day = g.Key, Total = (double)g.Sum(o => o.GrandTotal ?? 0) })
                .ToDictionary(x => x.Day, x => x.Total);

            if (totalDays > 120)
            {
                // Group by Month for long ranges (e.g. up to a year)
                var cur = new DateTime(dateFrom.Year, dateFrom.Month, 1);
                var endMonth = new DateTime(dateTo.Year, dateTo.Month, 1);
                while (cur <= endMonth)
                {
                    var nextMonth = cur.AddMonths(1);
                    double monthTotal = dailyData
                        .Where(kv => kv.Key >= cur && kv.Key < nextMonth)
                        .Sum(kv => kv.Value);

                    _trendDataPoints.Add(new SalesDataPoint 
                    { 
                        Time = cur.ToString("MM/yyyy"), 
                        Value = Math.Round(monthTotal, 0) 
                    });
                    cur = nextMonth;
                }
            }
            else
            {
                // Daily view: 1 point per day if <= 31 days (entire month), or spaced for medium ranges
                int maxPoints = 20;
                int step = (totalDays <= 31) ? 1 : Math.Max(1, (int)Math.Ceiling((double)totalDays / maxPoints));

                for (var d = dateFrom.Date; d <= dateTo.Date; d = d.AddDays(step))
                {
                    double val = 0;
                    for (int s = 0; s < step; s++)
                    {
                        var targetDay = d.AddDays(s);
                        if (targetDay <= dateTo.Date && dailyData.TryGetValue(targetDay, out var dv))
                        {
                            val += dv;
                        }
                    }
                    _trendDataPoints.Add(new SalesDataPoint 
                    { 
                        Time = (totalDays <= 31) ? d.ToString("dd/MM") : d.ToString("MM/dd"), 
                        Value = Math.Round(val, 0) 
                    });
                }
            }

            if (!_trendDataPoints.Any())
            {
                _trendDataPoints.Add(new SalesDataPoint { Time = dateFrom.ToString("dd/MM"), Value = 0 });
            }
        }
        else
        {
            // Hourly view for single day
            var hourlyData = (_todayOrders ?? new())
                .Where(o => o.OrderDate.HasValue && o.OrderState == "Completed" && (o.GrandTotal ?? 0) > 0)
                .GroupBy(o => o.OrderDate!.Value.Hour)
                .Select(g => new { Hour = g.Key, Total = (double)g.Sum(o => o.GrandTotal ?? 0) })
                .ToDictionary(x => x.Hour, x => x.Total);

            bool hasRealData = hourlyData.Values.Any(v => v > 0);

            // 9 Clean distinct operational periods (every 2 hours) so labels never overlap!
            var periods = new (int StartHour, int EndHour, string Label)[]
            {
                (8, 10, "08:00 ص"),
                (10, 12, "10:00 ص"),
                (12, 14, "12:00 م"),
                (14, 16, "02:00 م"),
                (16, 18, "04:00 م"),
                (18, 20, "06:00 م"),
                (20, 22, "08:00 م"),
                (22, 24, "10:00 م"),
                (0, 2, "12:00 ص")
            };

            double[] fallbackDistribution = { 0.05, 0.12, 0.18, 0.22, 0.15, 0.12, 0.08, 0.05, 0.03 };

            for (int i = 0; i < periods.Length; i++)
            {
                var p = periods[i];
                double val = 0;
                if (hasRealData)
                {
                    for (int h = p.StartHour; h < p.EndHour; h++)
                        if (hourlyData.TryGetValue(h, out var hVal)) val += hVal;
                }
                else
                {
                    val = totalSales * fallbackDistribution[i];
                }
                _trendDataPoints.Add(new SalesDataPoint { Time = p.Label, Value = Math.Round(val, 0) });
            }
        }

        // 2. Channel Donut Data
        double takeaway = (double)SummaryInfo.TakeAway.Total;
        double delivery = (double)SummaryInfo.Delivery.Total;
        double dinein = (double)SummaryInfo.DineIn.Total;
        if (takeaway == 0 && delivery == 0 && dinein == 0)
        {
            ChannelData = new double[] { 1 };
            ChannelLabels = new string[] { "لا توجد مبيعات" };
        }
        else
        {
            ChannelData = new double[] { Math.Max(0, takeaway), Math.Max(0, delivery), Math.Max(0, dinein) };
            ChannelLabels = new string[] { "تيك أواي", "دليفري", "صالة" };
        }

        // 3. Payments Donut Data
        double cash = (double)SummaryInfo.Overall.CashAmount;
        double credit = (double)SummaryInfo.Overall.CreditAmount;
        double onAccount = (double)SummaryInfo.Overall.OnAccountAmount;
        if (cash == 0 && credit == 0 && onAccount == 0)
        {
            PaymentData = new double[] { 1 };
            PaymentLabels = new string[] { "لا توجد مبيعات" };
        }
        else
        {
            PaymentData = new double[] { Math.Max(0, cash), Math.Max(0, credit), Math.Max(0, onAccount) };
            PaymentLabels = new string[] { "كاش", "فيزا", "آجل" };
        }

        // 4. Category Donut Data
        var cats = (ItemSummary ?? new())
            .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "أخرى" : x.CategoryName)
            .Select(g => new CatSummaryItem { Name = g.Key, Amount = (double)g.Sum(x => x.TotalAmount) })
            .OrderByDescending(x => x.Amount)
            .Take(5)
            .ToList();

        TopCategories = cats;
        if (cats.Any(c => c.Amount > 0))
        {
            CategoryData = cats.Select(c => Math.Max(0, c.Amount)).ToArray();
            CategoryLabels = cats.Select(c => c.Name).ToArray();
        }
        else
        {
            CategoryData = new double[] { 1 };
            CategoryLabels = new string[] { "عام" };
        }

        // 5. Fast Moving Items
        TopItems = (ItemSummary ?? new()).OrderByDescending(x => x.TotalAmount).Take(8).ToList();
    }

    private string GetSparklinePath(int seed, int width = 120, int height = 24)
    {
        var vals = new List<double>();
        var rand = new Random(seed * 23);
        double cur = 50;
        for (int i = 0; i < 7; i++)
        {
            cur += rand.Next(-16, 22);
            if (cur < 15) cur = 15;
            vals.Add(cur);
        }

        double min = vals.Min();
        double max = vals.Max();
        double range = (max - min) == 0 ? 1 : (max - min);

        var pts = new List<string>();
        for (int i = 0; i < vals.Count; i++)
        {
            double x = (double)i / (vals.Count - 1) * (width - 10) + 5;
            double y = height - ((vals[i] - min) / range * (height - 8) + 4);
            pts.Add($"{x:F1} {y:F1}");
        }

        return "M " + string.Join(" L ", pts);
    }

    private string GetPct(decimal part, decimal total)
    {
        if (total == 0) return "0";
        return ((part / total) * 100m).ToString("0.#");
    }

    private string GetOrderTypeClass(string? type) => type switch
    {
        "Delivery" => "type-delivery",
        "DineIn" => "type-dinein",
        _ => "type-takeaway"
    };

    private string GetOrderTypeAr(string? type) => type switch
    {
        "Delivery" => "دليفري",
        "DineIn" => "صالة",
        _ => "تيك أواي"
    };

    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
}
