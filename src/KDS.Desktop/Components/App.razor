@using KDS.Desktop.Services
@inject KdsAppSettings KdsConfig
@inject NavigationManager NavManager

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
            <MudContainer>
                <MudText Typo="Typo.h4" Align="Align.Center" Style="color:#ef4444;margin-top:4rem;">الصفحة غير موجودة</MudText>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Navigate directly to the configured screen — no ScreenSelector UI
            if (KdsConfig.IsPickup)
                NavManager.NavigateTo($"/pickup/{KdsConfig.BranchId}/{KdsConfig.ScreenId}", replace: true);
            else
                NavManager.NavigateTo($"/kitchen/{KdsConfig.BranchId}/{KdsConfig.ScreenId}", replace: true);
        }
    }
}
