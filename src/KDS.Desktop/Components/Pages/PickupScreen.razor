        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        background-color: #0b1120;
        color: #f1f5f9;
        overflow: hidden;
        user-select: none;
        outline: none;
    }

    .pickup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0f172a;
        padding: 0.6rem 1.2rem;
        border-bottom: 2px solid #1e293b;
        flex-shrink: 0;
    }
    .pickup-header-right, .pickup-header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .pickup-header-center {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .pickup-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #34d399;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .ready-count {
        background: #065f46;
        color: #34d399;
        padding: 0.3rem 0.9rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
    }
    .preparing-count {
        background: #1e3a5f;
        color: #93c5fd;
        padding: 0.3rem 0.9rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
    }
    .pickup-clock {
        font-size: 1.3rem;
        font-weight: 700;
        color: #e2e8f0;
        font-family: 'Outfit', monospace;
        direction: ltr;
    }
    .pickup-branch { font-size: 0.75rem; color: #64748b; }

    .pickup-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
    }
    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #1e293b;
        border-top-color: #34d399;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
