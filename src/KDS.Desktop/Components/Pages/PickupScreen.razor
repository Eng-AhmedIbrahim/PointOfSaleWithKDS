    @@keyframes spin { to { transform: rotate(360deg); } }

    .pickup-columns-container {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.75rem;
        padding: 0.75rem;
        overflow-y: auto;
        flex: 1;
        align-content: start;
