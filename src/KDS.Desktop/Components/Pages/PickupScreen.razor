@page "/pickup/{BranchId:int}"
@page "/pickup/{BranchId:int}/{ScreenId:int}"
@inject IKdsErpService KdsService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<div class="pickup-container" tabindex="0" @onkeydown="HandleKeyDown" @ref="_containerRef">
    <!-- Header Bar -->
    <div class="pickup-header">
        <div class="pickup-header-right">
            <div class="pickup-title">
                <img src="images/logo.png" alt="Logo" style="height: 32px; width: 32px; object-fit: contain; margin-left: 6px;" />
                شاشة الاستلام
            </div>
        </div>
        <div class="pickup-header-center">
            <span class="ready-count">@_ready.Count جاهز للاستلام</span>
        </div>
        <div class="pickup-header-left">
            <div class="pickup-clock">@_currentTime.ToString("hh:mm:ss tt")</div>
            <div class="pickup-branch">فرع @BranchId @(ScreenId > 0 ? $"| شاشة {ScreenId}" : "")</div>
        </div>
    </div>

    <!-- Loading / Empty State -->
    @if (_isLoading)
    {
        <div class="pickup-center">
            <div class="loading-spinner"></div>
            <div style="color:#64748b;margin-top:1rem;">جاري التحميل...</div>
        </div>
    }
    else if (_ready.Count == 0)
    {
        <div class="pickup-center">
            <div style="font-size:4rem;">🎉</div>
            <div style="color:#10b981;font-size:1.5rem;font-weight:700;margin-top:1rem;">لا توجد طلبات جاهزة حالياً</div>
            <div style="color:#64748b;margin-top:0.5rem;">الطلبات الجاهزة ستظهر هنا تلقائياً</div>
        </div>
    }
    else
    {
        <!-- Ticket Grid -->
        <div class="pickup-grid">
            @for (int i = 0; i < _ready.Count; i++)
            {
                var ticket = _ready[i];
                var idx = i;
                <div class="pickup-ticket @(idx == _selectedIndex ? "ticket-selected" : "")"
                     @onclick="() => SelectAndFocus(idx)">
                    <!-- Ticket Header -->
                    <div class="ticket-top">
                        <div class="ready-order-num">#@ticket.DailyOrderNumber</div>
                        <div class="elapsed-badge">⏱ @FormatElapsed(ticket.ElapsedMinutes)</div>
                    </div>

                    <!-- Order Info -->
                    <div class="ticket-meta">
                        <div class="order-type-badge">@ticket.OrderTypeName</div>
                        @if (!string.IsNullOrEmpty(ticket.TableName))
                        {
                            <div class="table-badge">طاولة: @ticket.TableName</div>
                        }
                        @if (!string.IsNullOrEmpty(ticket.CustomerName))
                        {
                            <div class="customer-name">👤 @ticket.CustomerName</div>
                        }
                        @if (!string.IsNullOrEmpty(ticket.CustomerPhone))
                        {
                            <div class="phone-badge">📞 @ticket.CustomerPhone</div>
                        }
                    </div>

                    <!-- Items List -->
                    <div class="ticket-items">
                        @foreach (var item in ticket.Items)
                        {
                            <div class="ticket-item">
                                <span class="item-qty">@item.Quantity ×</span>
                                <span class="item-name">@(item.ItemNameAr ?? item.ItemName)</span>
                                @if (!string.IsNullOrEmpty(item.Comment))
                                {
                                    <div class="item-comment">📝 @item.Comment</div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Deliver Button -->
                    <div class="ticket-footer">
                        <button class="btn-deliver" @onclick="() => CompleteOrder(ticket.OrderId)" @onclick:stopPropagation="true">
                            ✓ تسليم الطلب (Enter)
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Footer -->
    <div class="pickup-legend">
        <span class="shortcut">Enter / المسافة: تسليم المحدد</span>
        <span class="sep">|</span>
        <span class="shortcut">الأسهم: التنقل</span>
        <span class="sep">|</span>
        <span class="shortcut">Home / End: أول / آخر</span>
        <span class="sep">|</span>
        <span class="shortcut">تحديث تلقائي كل 8 ثوان</span>
    </div>
</div>

<style>
    .pickup-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        background-color: #0b1120;
        color: #f1f5f9;
        overflow: hidden;
        user-select: none;
        outline: none;
    }

    .pickup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0f172a;
        padding: 0.6rem 1.2rem;
        border-bottom: 2px solid #1e293b;
        flex-shrink: 0;
    }
    .pickup-header-right, .pickup-header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .pickup-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #34d399;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .ready-count {
        background: #065f46;
        color: #34d399;
        padding: 0.3rem 0.9rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
    }
    .pickup-clock {
        font-size: 1.3rem;
        font-weight: 700;
        color: #e2e8f0;
        font-family: 'Outfit', monospace;
        direction: ltr;
    }
    .pickup-branch { font-size: 0.75rem; color: #64748b; }

    /* Center empty/loading state */
    .pickup-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
    }
    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #1e293b;
        border-top-color: #34d399;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Grid — same pattern as kitchen */
    .pickup-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 0.85rem;
        padding: 0.85rem;
        overflow-y: auto;
        flex: 1;
        align-content: start;
    }

    .pickup-ticket {
        background: #0d2818;
        border: 2px solid #065f46;
        border-top: 5px solid #10b981;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: transform 0.15s, border-color 0.15s;
        cursor: pointer;
    }
    .ticket-selected {
        outline: 3px solid #34d399;
        transform: scale(1.02);
        box-shadow: 0 0 24px rgba(52, 211, 153, 0.45);
        z-index: 10;
    }

    .ticket-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0.75rem 0.3rem;
    }
    .ready-order-num { font-size: 2.2rem; font-weight: 900; color: #10b981; line-height: 1; }
    .elapsed-badge {
        font-size: 0.85rem;
        font-weight: 700;
        color: #f59e0b;
        background: rgba(245,158,11,0.12);
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
    }

    .ticket-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        padding: 0 0.75rem 0.4rem;
        font-size: 0.78rem;
    }
    .order-type-badge {
        background: #064e3b;
        color: #6ee7b7;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-weight: 700;
    }
    .table-badge  { background: #14532d; color: #4ade80; padding: 0.15rem 0.45rem; border-radius: 4px; font-weight: 700; }
    .customer-name { color: #94a3b8; padding: 0.15rem 0; font-weight: 600; }
    .phone-badge { color: #7dd3fc; padding: 0.15rem 0; font-weight: 600; }

    .ticket-items {
        flex: 1;
        padding: 0.4rem 0.75rem;
        overflow-y: auto;
        max-height: 240px;
        border-top: 1px solid #064e3b;
    }
    .ticket-item {
        padding: 0.35rem 0;
        border-bottom: 1px dashed #1e293b;
        font-size: 0.95rem;
        line-height: 1.3;
    }
    .ticket-item:last-child { border-bottom: none; }
    .item-qty  { font-weight: 900; color: #34d399; margin-left: 0.4rem; font-size: 1.05rem; }
    .item-name { color: #f1f5f9; font-weight: 700; }
    .item-comment { font-size: 0.75rem; color: #fbbf24; margin-top: 0.15rem; padding-right: 1.2rem; }

    .ticket-footer {
        padding: 0.5rem 0.75rem;
        background: #022c22;
        border-top: 1px solid #064e3b;
    }
    .btn-deliver {
        width: 100%;
        background: #10b981;
        color: #022c22;
        border: none;
        border-radius: 8px;
        padding: 0.55rem;
        font-weight: 800;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s;
        animation: pulse-green 1.5s ease-in-out infinite;
    }
    .btn-deliver:hover { background: #059669; color: #fff; animation: none; }
    @@keyframes pulse-green { 0%,100% { opacity:1; } 50% { opacity:0.78; } }

    .pickup-legend {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: #0f172a;
        border-top: 1px solid #1e293b;
        padding: 0.4rem;
        font-size: 0.75rem;
        color: #475569;
        flex-shrink: 0;
    }
    .sep { color: #334155; }
    .shortcut { color: #475569; }
</style>

@code {
    [Parameter] public int BranchId { get; set; }
    [Parameter] public int ScreenId { get; set; }

    private List<KdsOrderTicketDto> _ready = new();
    private int _selectedIndex = 0;
    private bool _isLoading = true;
    private DateTime _currentTime = DateTime.Now;
    private System.Timers.Timer? _refreshTimer;
    private System.Timers.Timer? _clockTimer;
    private ElementReference _containerRef;
    private int _prevReadyCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();

        _refreshTimer = new System.Timers.Timer(8_000);
        _refreshTimer.Elapsed += async (_, _) => await InvokeAsync(RefreshOrders);
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();

        _clockTimer = new System.Timers.Timer(1_000);
        _clockTimer.Elapsed += async (_, _) =>
        {
            _currentTime = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        };
        _clockTimer.AutoReset = true;
        _clockTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("kdsFocus.init", _containerRef); }
            catch { }
        }
    }

    private async Task LoadOrders()
    {
        _isLoading = true;
        var all = await KdsService.GetActivePickupOrders(BranchId, ScreenId);
        _ready = all.Where(o => o.Status == "Ready").ToList();
        _prevReadyCount = _ready.Count;
        _isLoading = false;
        if (_selectedIndex >= _ready.Count)
            _selectedIndex = Math.Max(0, _ready.Count - 1);
    }

    private async Task RefreshOrders()
    {
        var all = await KdsService.GetActivePickupOrders(BranchId, ScreenId);
        var newReady = all.Where(o => o.Status == "Ready").ToList();
        bool hasNew = newReady.Count > _prevReadyCount;
        _prevReadyCount = newReady.Count;
        _ready = newReady;
        if (_selectedIndex >= _ready.Count)
            _selectedIndex = Math.Max(0, _ready.Count - 1);
        if (hasNew)
        {
            try { await JS.InvokeVoidAsync("kdsAudio.playReadyChime"); } catch { }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CompleteOrder(int orderId)
    {
        await KdsService.CompletePickupOrder(orderId);
        await LoadOrders();
        StateHasChanged();
    }

    private void SelectAndFocus(int idx)
    {
        _selectedIndex = idx;
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowUp":
                _selectedIndex = Math.Max(0, _selectedIndex - 1);
                StateHasChanged();
                break;
            case "ArrowLeft":
            case "ArrowDown":
                _selectedIndex = Math.Min(_ready.Count - 1, _selectedIndex + 1);
                StateHasChanged();
                break;
            case "Tab":
                if (_ready.Count > 0)
                {
                    _selectedIndex = (_selectedIndex + 1) % _ready.Count;
                    StateHasChanged();
                }
                break;
            case "Enter":
            case " ":
                if (_ready.Count > 0 && _selectedIndex < _ready.Count)
                    await CompleteOrder(_ready[_selectedIndex].OrderId);
                break;
            case "Home":
                _selectedIndex = 0;
                StateHasChanged();
                break;
            case "End":
                _selectedIndex = Math.Max(0, _ready.Count - 1);
                StateHasChanged();
                break;
            default:
                if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
                {
                    int target = int.Parse(e.Key) - 1;
                    if (target >= 0 && target < _ready.Count)
                    {
                        _selectedIndex = target;
                        StateHasChanged();
                    }
                }
                break;
        }
    }

    private string FormatElapsed(double minutes)
    {
        int m = (int)minutes;
        int s = (int)((minutes - m) * 60);
        return $"{m:D2}:{s:D2}";
    }

    public void Dispose()
    {
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        _clockTimer?.Stop();
        _clockTimer?.Dispose();
    }
}
