@page "/pickup/{BranchId:int}"
@page "/pickup/{BranchId:int}/{ScreenId:int}"
@inject IKdsErpService KdsService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<div class="pickup-container" tabindex="0" @onkeydown="HandleKeyDown" @ref="_containerRef">
    <!-- Header -->
    <div class="pickup-header">
        <div class="pickup-header-right">
            <button class="btn-back" @onclick="GoBack">← رجوع</button>
            <div class="pickup-title">
                <span>📋</span>
                شاشة الاستلام
            </div>
        </div>
        <div class="pickup-header-center">
            <div class="pickup-clock">@_currentTime.ToString("hh:mm:ss tt")</div>
        </div>
        <div class="pickup-header-left">
            <div class="pickup-branch">فرع @BranchId @(ScreenId > 0 ? $"| شاشة {ScreenId}" : "")</div>
            <div class="keyboard-hint">Tab للتنقل | Enter تسليم الطلب المحدد</div>
        </div>
    </div>

    <!-- Two-column layout -->
    <div class="pickup-body">
        <!-- Preparing Column -->
        <div class="pickup-col col-preparing">
            <div class="col-header preparing-header">
                <span class="col-icon">🍳</span>
                <span class="col-title">قيد التحضير</span>
                <span class="col-count">@_preparing.Count</span>
            </div>
            <div class="col-cards">
                @if (_preparing.Count == 0)
                {
                    <div class="empty-col">لا توجد طلبات قيد التحضير</div>
                }
                @foreach (var ticket in _preparing)
                {
                    <div class="pickup-card preparing-card">
                        <div class="pickup-card-header">
                            <div class="pickup-order-num">#@ticket.DailyOrderNumber</div>
                            <div class="pickup-order-type">@ticket.OrderTypeName</div>
                        </div>

                        <div class="pickup-meta-row">
                            @if (!string.IsNullOrEmpty(ticket.CustomerName))
                            {
                                <span class="pickup-customer">👤 @ticket.CustomerName</span>
                            }
                            @if (!string.IsNullOrEmpty(ticket.CustomerPhone))
                            {
                                <span class="pickup-phone">📞 @ticket.CustomerPhone</span>
                            }
                            @if (!string.IsNullOrEmpty(ticket.TableName))
                            {
                                <span class="pickup-table">🍽 @ticket.TableName</span>
                            }
                            <span class="pickup-elapsed">⏱ @FormatElapsed(ticket.ElapsedMinutes)</span>
                        </div>

                        <!-- Full Items Display -->
                        <div class="pickup-items-box">
                            @foreach (var item in ticket.Items)
                            {
                                <div class="pickup-item-line">
                                    <span class="p-qty">@item.Quantity ×</span>
                                    <span class="p-name">@(item.ItemNameAr ?? item.ItemName)</span>
                                    @if (!string.IsNullOrEmpty(item.Comment))
                                    {
                                        <span class="p-comment">(@item.Comment)</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Ready Column -->
        <div class="pickup-col col-ready">
            <div class="col-header ready-header">
                <span class="col-icon">✅</span>
                <span class="col-title">جاهز للاستلام</span>
                <span class="col-count">@_ready.Count</span>
            </div>
            <div class="col-cards">
                @if (_ready.Count == 0)
                {
                    <div class="empty-col">لا توجد طلبات جاهزة</div>
                }
                @for (int i = 0; i < _ready.Count; i++)
                {
                    var ticket = _ready[i];
                    var idx = i;
                    <div class="pickup-card ready-card @(idx == _focusedReadyIndex ? "ready-focused" : "")"
                         @onclick="() => SelectReady(idx)">
                        <div class="pickup-card-header">
                            <div class="ready-order-num">#@ticket.DailyOrderNumber</div>
                            <div class="ready-order-type">@ticket.OrderTypeName</div>
                        </div>

                        <div class="pickup-meta-row">
                            @if (!string.IsNullOrEmpty(ticket.CustomerName))
                            {
                                <span class="pickup-customer">👤 @ticket.CustomerName</span>
                            }
                            @if (!string.IsNullOrEmpty(ticket.CustomerPhone))
                            {
                                <span class="pickup-phone">📞 @ticket.CustomerPhone</span>
                            }
                            @if (!string.IsNullOrEmpty(ticket.TableName))
                            {
                                <span class="pickup-table">🍽 @ticket.TableName</span>
                            }
                        </div>

                        <!-- Full Items Display -->
                        <div class="pickup-items-box">
                            @foreach (var item in ticket.Items)
                            {
                                <div class="pickup-item-line">
                                    <span class="p-qty ready-qty">@item.Quantity ×</span>
                                    <span class="p-name">@(item.ItemNameAr ?? item.ItemName)</span>
                                    @if (!string.IsNullOrEmpty(item.Comment))
                                    {
                                        <span class="p-comment">(@item.Comment)</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="ready-action">
                            @if (idx == _focusedReadyIndex)
                            {
                                <button class="focused-btn" @onclick="() => CompleteOrder(ticket.OrderId)" @onclick:stopPropagation="true">
                                    ✓ تسليم الطلب (Enter)
                                </button>
                            }
                            else
                            {
                                <button class="unfocused-btn" @onclick="() => SelectReady(idx)">
                                    انقر للاختيار أو اضغط Tab
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="pickup-legend">
        <span>Tab = تنقل بين الجاهزين</span>
        <span class="sep">|</span>
        <span>Enter = تسليم الطلب وإنهاؤه</span>
        <span class="sep">|</span>
        <span class="auto-refresh-info">تحديث تلقائي كل 8 ثوان</span>
    </div>
</div>

<style>
    .pickup-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        background-color: #0b1120;
        color: #f1f5f9;
        overflow: hidden;
        user-select: none;
        outline: none;
    }

    .pickup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0f172a;
        padding: 0.6rem 1.5rem;
        border-bottom: 2px solid #1e293b;
        flex-shrink: 0;
    }
    .pickup-header-right, .pickup-header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .btn-back {
        background: #1e293b;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 0.35rem 0.8rem;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .btn-back:hover { background: #334155; color: #fff; }

    .pickup-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #38bdf8;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .pickup-clock {
        font-size: 1.5rem;
        font-weight: 800;
        color: #f8fafc;
        font-family: 'Outfit', monospace;
        direction: ltr;
    }
    .pickup-branch { font-size: 0.85rem; color: #64748b; }
    .keyboard-hint { font-size: 0.75rem; color: #475569; }

    .pickup-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        flex: 1;
        overflow: hidden;
    }

    .pickup-col {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-left: 2px solid #1e293b;
    }
    .pickup-col:last-child { border-left: none; }

    .col-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.5rem;
        font-weight: 800;
        font-size: 1.15rem;
        border-bottom: 2px solid #1e293b;
        flex-shrink: 0;
    }
    .preparing-header { background: #1e293b; color: #60a5fa; }
    .ready-header     { background: #064e3b; color: #34d399; }
    .col-count {
        background: rgba(0,0,0,0.3);
        border-radius: 20px;
        padding: 0.2rem 0.7rem;
        font-size: 0.95rem;
    }

    .col-cards {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .empty-col {
        color: #475569;
        text-align: center;
        margin-top: 4rem;
        font-size: 1.1rem;
    }

    .pickup-card {
        border-radius: 12px;
        padding: 0.85rem 1rem;
        transition: transform 0.15s, border-color 0.15s;
    }

    .pickup-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.35rem;
    }

    .preparing-card {
        background: #111827;
        border: 2px solid #1e3a5f;
    }
    .ready-card {
        background: #0d2818;
        border: 2px solid #065f46;
        cursor: pointer;
    }
    .ready-focused {
        border: 3px solid #10b981;
        transform: scale(1.02);
        box-shadow: 0 0 24px rgba(16, 185, 129, 0.4);
    }

    .pickup-order-num { font-size: 2.2rem; font-weight: 900; color: #38bdf8; line-height: 1; }
    .ready-order-num  { font-size: 2.4rem; font-weight: 900; color: #10b981; line-height: 1; }
    .pickup-order-type, .ready-order-type {
        font-size: 0.85rem;
        color: #94a3b8;
        background: rgba(255,255,255,0.06);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .pickup-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        font-size: 0.85rem;
        color: #cbd5e1;
        margin-bottom: 0.5rem;
    }
    .pickup-elapsed { font-size: 0.8rem; color: #f59e0b; font-weight: 700; margin-right: auto; }

    /* Full items box inside pickup cards */
    .pickup-items-box {
        background: rgba(0, 0, 0, 0.25);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        margin-top: 0.4rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
        max-height: 180px;
        overflow-y: auto;
    }
    .pickup-item-line {
        padding: 0.25rem 0;
        font-size: 0.95rem;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .pickup-item-line:last-child { border-bottom: none; }
    .p-qty { font-weight: 900; color: #38bdf8; font-size: 1rem; }
    .ready-qty { color: #34d399; }
    .p-name { color: #f8fafc; font-weight: 700; }
    .p-comment { font-size: 0.78rem; color: #fde047; }

    .ready-action { margin-top: 0.75rem; text-align: center; }
    .focused-btn {
        width: 100%;
        background: #10b981;
        color: #000;
        border: none;
        border-radius: 8px;
        padding: 0.5rem;
        font-size: 0.95rem;
        font-weight: 800;
        cursor: pointer;
        animation: pulse-green 1s ease-in-out infinite;
    }
    .unfocused-btn {
        background: transparent;
        border: 1px dashed #334155;
        color: #64748b;
        border-radius: 6px;
        padding: 0.3rem 0.8rem;
        font-size: 0.8rem;
        cursor: pointer;
    }
    @@keyframes pulse-green { 0%,100% { opacity:1; } 50% { opacity:0.75; } }

    .pickup-legend {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: #0f172a;
        border-top: 1px solid #1e293b;
        padding: 0.4rem;
        font-size: 0.75rem;
        color: #475569;
        flex-shrink: 0;
    }
    .sep { color: #334155; }
    .auto-refresh-info { color: #374151; }
</style>

@code {
    [Parameter] public int BranchId { get; set; }
    [Parameter] public int ScreenId { get; set; }

    private List<KdsOrderTicketDto> _preparing = new();
    private List<KdsOrderTicketDto> _ready = new();
    private int _focusedReadyIndex = 0;
    private DateTime _currentTime = DateTime.Now;
    private System.Timers.Timer? _refreshTimer;
    private System.Timers.Timer? _clockTimer;
    private ElementReference _containerRef;
    private int _prevReadyCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();

        _refreshTimer = new System.Timers.Timer(8_000);
        _refreshTimer.Elapsed += async (_, _) => await InvokeAsync(RefreshOrders);
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();

        _clockTimer = new System.Timers.Timer(1_000);
        _clockTimer.Elapsed += async (_, _) =>
        {
            _currentTime = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        };
        _clockTimer.AutoReset = true;
        _clockTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("kdsFocus.init", _containerRef);
            }
            catch { }
        }
    }

    private async Task LoadOrders()
    {
        var all = await KdsService.GetActivePickupOrders(BranchId, ScreenId);
        SplitOrders(all);
    }

    private async Task RefreshOrders()
    {
        var all = await KdsService.GetActivePickupOrders(BranchId, ScreenId);
        int newReadyCount = all.Count(o => o.Status == "Ready");
        bool newReady = newReadyCount > _prevReadyCount;
        _prevReadyCount = newReadyCount;
        SplitOrders(all);
        if (newReady)
        {
            try { await JS.InvokeVoidAsync("kdsAudio.playReadyChime"); } catch { }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void SplitOrders(List<KdsOrderTicketDto> all)
    {
        _preparing = all.Where(o => o.Status == "Preparing").ToList();
        _ready = all.Where(o => o.Status == "Ready").ToList();
        if (_focusedReadyIndex >= _ready.Count)
            _focusedReadyIndex = Math.Max(0, _ready.Count - 1);
        _prevReadyCount = _ready.Count;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Tab":
                if (_ready.Count > 0)
                {
                    _focusedReadyIndex = (_focusedReadyIndex + 1) % _ready.Count;
                    StateHasChanged();
                }
                break;
            case "Enter":
                if (_ready.Count > 0 && _focusedReadyIndex < _ready.Count)
                {
                    await CompleteOrder(_ready[_focusedReadyIndex].OrderId);
                }
                break;
        }
    }

    private async Task CompleteOrder(int orderId)
    {
        await KdsService.CompletePickupOrder(orderId);
        await LoadOrders();
        StateHasChanged();
    }

    private void SelectReady(int idx)
    {
        _focusedReadyIndex = idx;
        StateHasChanged();
    }

    private string FormatElapsed(double minutes)
    {
        int m = (int)minutes;
        int s = (int)((minutes - m) * 60);
        return $"{m:D2}:{s:D2}";
    }

    private void GoBack() => NavManager.NavigateTo("/");

    public void Dispose()
    {
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        _clockTimer?.Stop();
        _clockTimer?.Dispose();
    }
}
