@page "/pickup/{BranchId:int}"
@page "/pickup/{BranchId:int}/{ScreenId:int}"
@inject IKdsErpService KdsService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<div class="pickup-container" tabindex="0" @onkeydown="HandleKeyDown" @ref="_containerRef">
    <!-- Header Bar -->
    <div class="pickup-header">
        <div class="pickup-header-right">
            <div class="pickup-title">
                <img src="images/logo.png" alt="Logo" style="height: 32px; width: 32px; object-fit: contain; margin-left: 6px;" />
                شاشة الاستلام
            </div>
        </div>
        <div class="pickup-header-center">
            <span class="ready-count">✅ @_ready.Count جاهز</span>
            @if (_preparing.Count > 0)
            {
                <span class="preparing-count">🍳 @_preparing.Count قيد التحضير</span>
            }
        </div>
        <div class="pickup-header-left">
            <div class="pickup-clock">@_currentTime.ToString("hh:mm:ss tt")</div>
            <div class="pickup-branch">فرع @BranchId @(ScreenId > 0 ? $"| شاشة {ScreenId}" : "")</div>
        </div>
    </div>

    <!-- Loading / Empty State -->
    @if (_isLoading)
    {
        <div class="pickup-center">
            <div class="loading-spinner"></div>
            <div style="color:#64748b;margin-top:1rem;">جاري التحميل...</div>
        </div>
    }
    else if (_allTickets.Count == 0)
    {
        <div class="pickup-center">
            <div style="font-size:4rem;">🎉</div>
            <div style="color:#10b981;font-size:1.5rem;font-weight:700;margin-top:1rem;">لا توجد طلبات حالياً</div>
            <div style="color:#64748b;margin-top:0.5rem;">الطلبات ستظهر هنا تلقائياً</div>
        </div>
    }
    else
    {
        <!-- Columns Layout — Side-by-side with no fixed height -->
        <div class="pickup-columns-container">
            @foreach (var col in GetColumns())
            {
                <div class="pickup-column">
                    @foreach (var ticket in col)
                    {
                        var idx = _allTickets.IndexOf(ticket);
                        bool isReady = ticket.Status == "Ready";
                        <div class="pickup-ticket @(isReady ? "ticket-ready" : "ticket-preparing") @(idx == _selectedIndex ? "ticket-selected" : "")"
                             @onclick="() => SelectAndFocus(idx)">
                            <!-- Ticket Header -->
                            <div class="ticket-top">
                                <div class="order-num @(isReady ? "num-ready" : "num-preparing")">#@ticket.DailyOrderNumber</div>
                                <div class="status-badge @(isReady ? "badge-ready" : "badge-preparing")">
                                    @(isReady ? "✅ جاهز" : "🍳 يُحضَّر")
                                </div>
                            </div>

                            <!-- Order Info -->
                            <div class="ticket-meta">
                                <div class="order-type-badge @(isReady ? "type-ready" : "type-preparing")">@ticket.OrderTypeName</div>
                                @if (!string.IsNullOrEmpty(ticket.TableName))
                                {
                                    <div class="table-badge">طاولة: @ticket.TableName</div>
                                }
                                @if (!string.IsNullOrEmpty(ticket.CustomerName))
                                {
                                    <div class="customer-name">👤 @ticket.CustomerName</div>
                                }
                                @if (!string.IsNullOrEmpty(ticket.CustomerPhone))
                                {
                                    <div class="phone-badge">📞 @ticket.CustomerPhone</div>
                                }
                                <div class="elapsed-badge">⏱ @FormatElapsed(ticket.ElapsedMinutes)</div>
                            </div>

                            <!-- Items List -->
                            <div class="ticket-items">
                                @foreach (var item in ticket.Items)
                                {
                                    <div class="ticket-item">
                                        <span class="item-qty @(isReady ? "qty-ready" : "qty-preparing")">@item.Quantity ×</span>
                                        <span class="item-name">@(item.ItemNameAr ?? item.ItemName)</span>
                                        @if (!string.IsNullOrEmpty(item.Comment))
                                        {
                                            <div class="item-comment">📝 @item.Comment</div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Action Button -->
                            <div class="ticket-footer">
                                @if (isReady)
                                {
                                    <button class="btn-deliver" @onclick="() => CompleteOrder(ticket.OrderId)" @onclick:stopPropagation="true">
                                        ✓ تسليم الطلب (Enter)
                                    </button>
                                }
                                else
                                {
                                    <div class="btn-waiting">⏳ في انتظار التحضير...</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Footer -->
    <div class="pickup-legend">
        <span class="shortcut">Enter / المسافة: تسليم المحدد</span>
        <span class="sep">|</span>
        <span class="shortcut">الأسهم: التنقل التلقائي</span>
        <span class="sep">|</span>
        <span class="shortcut">PageUp / PageDown: تحريك الشاشة</span>
        <span class="sep">|</span>
        <span class="shortcut">Esc: إغلاق</span>
        <span class="sep">|</span>
        <span class="shortcut">تحديث تلقائي كل 8 ثوان</span>
    </div>
</div>

<style>
