@page "/all-orders"
@layout MainLayout
@inject IReportingErpService ReportingService
@inject IAppDateService AppDateService
@inject LocalizationService Localizer
@inject CommonProperties _commonProperties
@inject ISnackbar Snackbar
@inject NavigationManager _navigationManager
@attribute [Authorize(Policy = "CanAccessOrders")]
@namespace POS.Desktop.Components.Pages.AllOrdersPages

<MudRTLProvider RightToLeft="@(Localizer.GetCurrentLanguage() == "ar")" Style="width: 100%; height: 100%;">
    <div class="orders-container" dir="@(Localizer.GetCurrentLanguage() == "ar" ? "rtl" : "ltr")" style="padding-bottom: 0;">
        <div class="orders-header fade-in">
            <div class="title-section d-flex align-center">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="GoBack" Class="@(Localizer.GetCurrentLanguage() == "ar" ? "ml-4 hover-back" : "mr-4 hover-back")" />
                <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Large" Class="@(Localizer.GetCurrentLanguage() == "ar" ? "ml-2" : "mr-2")" />
                <MudText Typo="Typo.h5" Style="font-weight: 700;">@Localizer["TodayOrders"]</MudText>
            </div>

            <div class="filter-section">
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToInnerViews="true" Class="custom-tabs" @bind-ActivePanelIndex="_activeTab">
                    <MudTabPanel Text="@Localizer["All"]" Icon="@Icons.Material.Filled.AllInclusive" />
                    <MudTabPanel Text="@Localizer["DineIn"]" Icon="@Icons.Material.Filled.TableRestaurant" />
                    <MudTabPanel Text="@Localizer["Delivery"]" Icon="@Icons.Material.Filled.DeliveryDining" />
                    <MudTabPanel Text="@Localizer["TakeAway"]" Icon="@Icons.Material.Filled.DirectionsRun" />
                </MudTabs>
                
                <MudTextField @bind-Value="_searchText" Placeholder="@Localizer["SearchByOrderOrPhone"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="@(Localizer.GetCurrentLanguage() == "ar" ? "mr-4" : "ml-4")" Style="width: 250px;" />
                
                <div class="d-flex gap-2 @(Localizer.GetCurrentLanguage() == "ar" ? "mr-2" : "ml-2")">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadOrders">@Localizer["Refresh"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="GoBack">@Localizer["Close"]</MudButton>
                </div>
            </div>
        </div>

        <div class="orders-content glass fade-in" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;">
            <MudTable Items="@FilteredOrders" Hover="true" Dense="true" Loading="@_isLoading" Elevation="0" Height="calc(100vh - 110px)" FixedHeader="true" Class="custom-table">
                <HeaderContent>
                    <MudTh Style="text-align: right;"><MudTableSortLabel SortBy="new Func<OrderDto, object>(x => x.OrderId)" InitialDirection="SortDirection.Descending">@Localizer["OrderID"]</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Time"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Type"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Customer"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Status"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Subtotal"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Discount"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["Total"]</MudTh>
                    <MudTh Style="text-align: center;">@Localizer["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="text-align: right;"><MudChip T="string" Color="Color.Default" Size="Size.Small">#@context.OrderId</MudChip></MudTd>
                    <MudTd Style="text-align: right;">@context.OrderDate?.ToString("hh:mm tt")</MudTd>
                    <MudTd Style="text-align: right;">
                        <MudChip T="string" Color="@GetOrderTypeColor(context.OrderType)" Variant="Variant.Filled" Size="Size.Small">
                            @Localizer[context.OrderType ?? ""]
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        <div class="customer-info" style="text-align: right;">
                            <span class="name">@(context.CustomerName ?? "-")</span>
                            <span class="phone">@context.Phone1</span>
                        </div>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        <MudChip T="string" Color="@GetStatusColor(context.OrderState)" Size="Size.Small">@Localizer[context.OrderState ?? ""]</MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right;">@context.SubTotal?.ToString("0.##")</MudTd>
                    <MudTd Style="text-align: right;" Class="text-red">
                        @if (context.TotalDiscount > 0)
                        {
                            <MudTooltip Placement="Placement.Bottom" Color="Color.Dark">
                                <ChildContent>
                                    <span style="cursor:pointer;">
                                        @context.TotalDiscount?.ToString("0.##")
                                        @if (!string.IsNullOrEmpty(context.DiscountReason) || !string.IsNullOrEmpty(context.DiscountByName))
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="font-size:14px; margin-right:2px; color:#ef4444;" />
                                        }
                                    </span>
                                </ChildContent>
                                <TooltipContent>
                                    <div style="text-align:right; direction:rtl; min-width:180px; padding:4px;">
                                        @if (!string.IsNullOrEmpty(context.DiscountType))
                                        {
                                            <div>نوع الخصم: <b>@context.DiscountType</b></div>
                                        }
                                        @if (context.DiscountPercentage > 0)
                                        {
                                            <div>نسبة الخصم: <b>@context.DiscountPercentage?.ToString("0.##")%</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(context.DiscountByName))
                                        {
                                            <div>بواسطة: <b>@context.DiscountByName</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(context.DiscountReason))
                                        {
                                            <div>← @context.DiscountReason</div>
                                        }
                                        @if (context.DiscountTime.HasValue)
                                        {
                                            <div>وقت الخصم: <b>@context.DiscountTime?.ToString("hh:mm tt")</b></div>
                                        }
                                    </div>
                                </TooltipContent>
                            </MudTooltip>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        @if (context.OrderState == "Voided")
                        {
                            <MudTooltip Placement="Placement.Bottom" Color="Color.Dark">
                                <ChildContent>
                                    <span style="color:#ef4444; font-weight:900; cursor:pointer;">
                                        <span style="text-decoration: line-through;">@(((context.VoidAmount > 0 ? context.VoidAmount : context.GrandTotal) ?? 0).ToString("0.##"))</span>
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="font-size:14px; margin-right:2px;" />
                                    </span>
                                </ChildContent>
                                <TooltipContent>
                                    <div style="text-align:right; direction:rtl; min-width:180px; padding:4px;">
                                        <div style="color:#ff6b6b; font-weight:900; margin-bottom:4px;">⚠ طلب ملغي</div>
                                        @if (!string.IsNullOrEmpty(context.VoidByName))
                                        {
                                            <div>بواسطة: <b>@context.VoidByName</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(context.VoidReason))
                                        {
                                            <div>← سبب الإلغاء: <b>@context.VoidReason</b></div>
                                        }
                                        @if (context.VoidTime.HasValue)
                                        {
                                            <div>وقت الإلغاء: <b>@context.VoidTime?.ToString("hh:mm tt")</b></div>
                                        }
                                        @if (context.VoidAmount > 0)
                                        {
                                            <div>مبلغ الإلغاء: <b>@context.VoidAmount?.ToString("0.##")</b></div>
                                        }
                                    </div>
                                </TooltipContent>
                            </MudTooltip>
                        }
                        else
                        {
                            <b class="total-text">@context.GrandTotal?.ToString("0.##")</b>
                            @if ((context.VoidAmount ?? context.TotalVoid ?? 0) > 0)
                            {
                                <div style="font-size: 11px; color: #ef4444; font-weight: 700;">
                                    (ملغي: @((context.VoidAmount ?? context.TotalVoid)?.ToString("0.##")))
                                </div>
                            }
                        }
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <MudMenu TransformOrigin="Origin.TopLeft" AnchorOrigin="Origin.BottomLeft" Dense="false">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.Settings" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Large">
                                    @Localizer["Actions"]
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                @if (_canViewOrder)
                                {
                                    <MudMenuItem OnClick="@(() => ViewOrder(context))" Icon="@Icons.Material.Filled.Visibility" IconColor="Color.Info" Class="action-menu-item">
                                        <MudText Typo="Typo.subtitle1">@Localizer["View"]</MudText>
                                    </MudMenuItem>
                                }
                                @if (_canPrintCustomerReceipt)
                                {
                                    <MudMenuItem OnClick="@(() => PrintCustomerOrderReceipt(context))" Icon="@Icons.Material.Filled.Receipt" IconColor="Color.Primary" Class="action-menu-item">
                                        <MudText Typo="Typo.subtitle1">@Localizer["CustomerReceipt"]</MudText>
                                    </MudMenuItem>
                                }
                                @if (_canPrintKitchenReceipt)
                                {
                                    <MudMenuItem OnClick="@(() => PrintBackupOrderReceipt(context))" Icon="@Icons.Material.Filled.Restaurant" IconColor="Color.Warning" Class="action-menu-item">
                                        <MudText Typo="Typo.subtitle1">@Localizer["KitchenReceipt"]</MudText>
                                    </MudMenuItem>
                                }
                                @if (_canVoidOrder && context.OrderState != "Voided")
                                {
                                    <MudMenuItem OnClick="@(() => VoidOrder(context))" Icon="@Icons.Material.Filled.Block" IconColor="Color.Error" Class="action-menu-item">
                                        <MudText Typo="Typo.subtitle1">@Localizer["Void"]</MudText>
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </div>
</MudRTLProvider>
